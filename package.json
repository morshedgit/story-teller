{
  "name": "story-teller",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-isolation.mjs",
    "audit": "node scripts/audit.mjs",
    "narrate": "node scripts/narrate.mjs",
    "shoot": "node scripts/shoot.mjs",
    "setup:tts": "python3 -m pip install -r requirements.txt",
    "check:tts": "python3 -c 'import sherpa_onnx; print(\"✓ sherpa-onnx ready\")'",
    "deploy": "astro build && wrangler deploy",
    "standalone": "node scripts/standalone.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "esbuild": "^0.25.0",
    "music-metadata": "^11.2.1",
    "playwright": "^1.50.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.118.0"
  }
}
