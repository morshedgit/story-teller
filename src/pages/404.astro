---
import Base from '../layouts/Base.astro';
import { ridge, props } from '../lib/anime-kit';
---

<Base title="Not found — Story Teller">
  <main id="main" class="wrap">
    <div class="art">
      <svg viewBox="0 0 1600 900" role="presentation">
        <g set:html={ridge({ palette: 'night', seed: 'lost', disc: 1240, discY: 200 })} />
        <g transform="translate(760 720)" set:html={props.lantern('#ffcf7a', '#0d1128')} />
      </svg>
    </div>
    <h1>Nothing on this line.</h1>
    <p>That page does not exist — but someone left a lantern on.</p>
    <p><a href="/">Back to the stories</a></p>
  </main>
</Base>

<style>
  main {
    padding: 70px 24px 100px;
    max-width: 720px;
    text-align: center;
  }
  .art {
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 32px;
    box-shadow: 0 20px 60px rgb(0 0 0 / 50%);
  }
  .art svg {
    display: block;
    width: 100%;
    height: auto;
  }
  h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }
  p {
    color: var(--text-dim);
  }
</style>
